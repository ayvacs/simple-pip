{
    "name": "Simple Picture-in-Picture",
    "description": "Watch videos using Picture-in-Picture; built for dark mode",
    "version": "2.0.0",
    "manifest_version": 3,
    "icons": {
        "128": "assets/icon128.png"
    },
    "background": {
        "scripts": [
            "background.js"
        ],
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": {
            "19": "assets/icon19.png",
            "38": "assets/icon38.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+P",
                "windows": "Alt+P",
                "mac": "Alt+P",
                "chromeos": "Alt+P",
                "linux": "Alt+P"
            },
            "description": "Toggle Picture-in-Picture"
        }
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "simple-pip@ayvacs",
            "strict_min_version": "109.0"
        }
    },
    "minimum_chrome_version": "88"
}
