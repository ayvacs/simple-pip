{
    "name": "Simple Picture-in-Picture",
    "description": "Watch videos using Picture-in-Picture; built for Chrome dark mode",
    "version": "1.1.0",
    "manifest_version": 3,
    "icons": {
        "128": "assets/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_icon": {
            "19": "assets/icon19.png",
            "38": "assets/icon38.png"
        }
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "windows": "Alt+P",
                "mac": "Alt+P",
                "chromeos": "Alt+P",
                "linux": "Alt+P"
            },
            "description": "Toggle Picture-in-Picture"
        }
    },
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "minimum_chrome_version": "88"
}
